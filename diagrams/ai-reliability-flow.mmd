flowchart TD
    INPUT["Untrusted user request"] --> LIMIT["Length and content validation"]
    LIMIT --> STRUCTURE["AI structured output"]
    STRUCTURE --> SCHEMA{"Schema valid?"}
    SCHEMA -->|"No"| RETRY["One bounded correction attempt"]
    RETRY --> SCHEMA2{"Now valid?"}
    SCHEMA2 -->|"No"| MANUAL["Manual or deterministic fallback"]
    SCHEMA -->|"Yes"| RETRIEVE["Retrieve approved catalog records"]
    SCHEMA2 -->|"Yes"| RETRIEVE
    RETRIEVE --> RANK["Deterministic evidence and ranking"]
    RANK --> GENERATE["Grounded explanation generation"]
    GENERATE --> FACTS{"Catalog facts and claims valid?"}
    FACTS -->|"No"| TEMPLATE["Deterministic explanation template"]
    FACTS -->|"Yes"| RESPONSE["Return grounded response"]
    TEMPLATE --> RESPONSE
    MANUAL --> RESPONSE
    RESPONSE --> LOG["Log IDs, timings, validation, and fallback"]
